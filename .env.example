# Copy to .env (never commit it). Every value is optional in development.

PUBLIC_URL=https://overdrive.vaultless.dev

# Hack Club Auth: auth.hackclub.com -> developer mode -> /developer/apps/new
# Redirect URI: ${PUBLIC_URL}/auth/hack_club/callback
# Scopes: email name slack_id verification_status
HCA_URL=https://auth.hackclub.com
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Where email RSVPers go to get a Hack Club account + Slack.
# Swap for the Overdrive onboarding link (/join/overdrive) once HQ makes one.
SLACK_JOIN_URL=https://hackclub.com/slack/

# Slack bot (config/slack_manifest.yml)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel ID (not name) RSVPers get invited to, e.g. C0123ABCD
SLACK_RSVP_CHANNEL_ID=

# Cloudflare Turnstile (blank = disabled)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated admins
ADMIN_SLACK_IDS=
ADMIN_EMAILS=

# Production only
# SECRET_KEY_BASE=   (bin/rails secret)
# SOLID_QUEUE_IN_PUMA=1
