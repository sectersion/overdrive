<% content_for :title, "RSVPs · Overdrive admin" %>

<section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="od-eyebrow">Admin</p>
      <h1 class="font-display mt-2 text-4xl font-black uppercase">RSVPs</h1>
    </div>
    <%= link_to "Download CSV", admin_rsvps_path(format: :csv), class: "od-btn-ghost" %>
  </div>

  <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-4">
    <% [ [ "Total", @stats[:total] ], [ "Hack Club linked", @stats[:linked] ], [ "Email only", @stats[:total] - @stats[:linked] ], [ "Refs", @by_ref.size ] ].each do |label, n| %>
      <div class="bg-surface p-5">
        <dt class="od-eyebrow"><%= label %></dt>
        <dd class="font-display mt-2 text-3xl font-black"><%= number_with_delimiter(n) %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="font-semibold">Top refs</h2>
      <ul class="mt-2 divide-y divide-line border-y border-line text-sm">
        <% @by_ref.first(15).each do |ref, n| %>
          <li class="flex justify-between py-2"><span class="font-mono"><%= ref %></span><span><%= n %></span></li>
        <% end %>
        <% if @by_ref.empty? %><li class="py-2 text-muted">No refs yet. Share links like <span class="font-mono">?ref=poster-ohio</span>.</li><% end %>
      </ul>
    </div>
    <div>
      <h2 class="font-semibold">Heard from</h2>
      <ul class="mt-2 divide-y divide-line border-y border-line text-sm">
        <% @by_heard.sort_by { -_2 }.each do |key, n| %>
          <li class="flex justify-between py-2"><span><%= Rsvp::HEARD_FROM[key] || key %></span><span><%= n %></span></li>
        <% end %>
        <% if @by_heard.empty? %><li class="py-2 text-muted">Nothing yet.</li><% end %>
      </ul>
    </div>
  </div>

  <div class="mt-10 overflow-x-auto rounded-lg border border-line">
    <table class="w-full min-w-[720px] text-left text-sm">
      <thead class="bg-surface">
        <tr class="od-eyebrow">
          <th class="p-3">When</th><th class="p-3">Who</th><th class="p-3">Via</th><th class="p-3">Building</th><th class="p-3">Ref</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @rsvps.each do |r| %>
          <tr>
            <td class="p-3 whitespace-nowrap text-muted"><%= time_ago_in_words(r.created_at) %> ago</td>
            <td class="p-3"><%= r.user&.display_name || r.email %><% unless r.linked? %> <span class="text-muted">(unlinked)</span><% end %></td>
            <td class="p-3 font-mono"><%= r.source %></td>
            <td class="p-3 text-muted"><%= r.building %></td>
            <td class="p-3 font-mono text-muted"><%= r.ref %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-sm text-muted">Showing the latest 500. The CSV has everyone.</p>
</section>
